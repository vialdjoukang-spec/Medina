  "consultations": [
    {
      "source": "ferro sanol",
      "url": "https://amiko.oddb.org/fr/fi?gtin=7680365270213",
      "version": "avril 2021",
      "private_file": "/workspace/work/cycle1-sources-D50/fi_ferro_sanol_P1.txt",
      "sha256": "a890cc0b045a8c8e52ba26554f11a6cc40beb54d715299527e875cb8d0dc692b",
      "scope": "Recherche produit puis texte ; contre-indications, mises en garde, interactions et date finale réellement relus.",
      "finding": "Les maladies digestives inflammatoires relèvent de la prudence. Leurs intitulés ne figurent pas dans la liste des contre-indications. Le passage produit ne permet pas d’inventer une contre-indication spécifique oral + IV ; cette attribution a été retirée de sa note."
    },
    {
      "source": "Tardyferon / Ferrum Hausmann",
      "url": "https://amiko.oddb.org/fr/fi?gtin=7680374480016",
      "additional_url": "https://amiko.oddb.org/fr/fi?gtin=7680351020433",
      "version": "juillet 2025 / mai 2021",
      "scope": "Listes de contre-indications et mises en garde réellement relues dans les textes privés déjà consultés.",
      "finding": "Intolérance prouvée pour Tardyferon, fondée pour Ferrum Hausmann : ces qualificatifs ne deviennent pas une interdiction universelle de tout fer oral en cas d’inflammation. L’attribution oral + IV a aussi été retirée de la note Ferrum, où elle ne constitue pas une contre-indication listée."
    },
    {
      "source": "Maltofer comprimé à croquer",
      "url": "https://amiko.oddb.org/fr/fi?gtin=7680465370844",
      "version": "août 2021",
      "private_file": "/workspace/work/cycle1-sources-D50/fi_Maltofer_croquer_P1.txt",
      "sha256": "0422090b1b8c48dcf7d0e19765937a1afa78d6b0a5cbad215299c1fae1395ec8",
      "scope": "Recherche exacte puis information professionnelle commune intégralement relue, y compris présentations, composition, posologie, précautions, pharmacologie et date.",
      "finding": "Comprimé à croquer : autorisation 46537, GTIN 7680465370844, 100 mg. Comprimé filmé : autorisation 55363, GTIN 7680553630041, 100 mg. Sirop : autorisation 30124, GTIN 7680301240218, 10 mg/mL. Le lien exact du comprimé filmé a été consulté ; son texte est byte-identique au texte commun effectivement lu, et ne constitue pas une seconde lecture indépendante."
    },
    {
      "source": "BSG 2021",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC8515119/",
      "section": "Background, Table 1, History and examination, exploration du grêle/capsule",
      "scope": "Passages effectivement relus après P1.",
      "finding": "Utilisation prolongée des anti-inflammatoires non stéroïdiens parmi les facteurs de risque ; entéropathie parmi les causes identifiées par capsule. L’exposition ne prouve pas une cause unique et ne dispense pas du bilan indiqué."
    },
    {
      "source": "Hoving et al. 2025",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC11985374/",
      "section": "Introduction et figure 1",
      "scope": "Introduction réellement relue dans le XML primaire, mécanisme normal et perturbation.",
      "finding": "La matriptase-2 codée par TMPRSS6 atténue la synthèse hépatique d’hepcidine via les protéines morphogénétiques osseuses et leurs médiateurs de signalisation. Les variants pathogènes dérèglent ce frein ; la fenêtre n’importe pas le contexte vasculaire pulmonaire du glossaire partagé."
    },
    {
      "source": "Onkopedia 2025 avec SGH/SSH et Delphi suisse 2019",
      "url": "https://www.onkopedia.com/de/onkopedia/guidelines/eisenmangel-und-eisenmangelanaemie/@@guideline/html/index.html",
      "additional_url": "https://doi.org/10.4414/smw.2019.20097",
      "section": "Onkopedia 3.5.6 et 3.6.1 ; discussion diagnostique du Delphi",
      "scope": "Passages ferritine, inflammation et bilan réellement relus.",
      "finding": "La protéine C réactive contextualise la ferritine ; inflammation, cancer et atteinte hépatique peuvent élever celle-ci malgré une carence. Aucun seuil général ne remplace les critères par population."
    },
    {
      "source": "ESsCD 2025 Partie 1",
      "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC12704582/",
      "section": "QII.1 et son résumé des preuves",
      "scope": "Recommandation et justification relues pour les termes développés.",
      "finding": "Anticorps anti-transglutaminase tissulaire de classe immunoglobuline A, immunoglobulines A totales simultanées, régime contenant du gluten. Les critères chiffrés d’immunodéficience du glossaire général ne sont plus importés."
    }
  ],
