  "course": {
    "code": "A41",
    "title": "Sepsis et choc septique de l’adulte"
  },
  "entries": 14,
  "windows": 14,
  "targets": 14,
  "matches": [
    {
      "file": "A41_a.html",
      "anchor": "a41-3",
      "text": "Cholestase inflammatoire, hypoperfusion",
      "id": "a41-j-cholestase",
      "start": 36610,
      "end": 36649
    },
    {
      "file": "A41_a.html",
      "anchor": "a41-4",
      "text": "Sélection de germes résistants",
      "id": "a41-j-selection",
      "start": 49890,
      "end": 49920
    },
    {
      "file": "A41_b.html",
      "anchor": "a41-9",
      "text": "Le stress et l’hydrocortisone élèvent la glycémie",
      "id": "a41-j-glycemie",
      "start": 48697,
      "end": 48746
    },
    {
      "file": "A41_b.html",
      "anchor": "a41-9",
      "text": "Le choc réduit la perfusion de la muqueuse gastrique",
      "id": "a41-j-muqueuse-gastrique",
      "start": 49332,
      "end": 49384
    },
    {
      "file": "A41_c.html",
      "anchor": "a41-e-2",
      "text": "Le rendement dépend d’un traitement antibiotique déjà reçu et du volume de prélèvement",
      "id": "a41-j-rendement-culture",
      "start": 10974,
      "end": 11060
    },
    {
      "file": "A41_c.html",
      "anchor": "a41-e-3",
      "text": "la pression partielle artérielle en oxygène et le pH",
      "id": "a41-j-gazometrie",
      "start": 16080,
      "end": 16132
    },
    {
      "file": "A41_c.html",
      "anchor": "a41-s-2",
      "text": "Ses jonctions et son glycocalyx contribuent à la barrière",
      "id": "a41-j-glycocalyx",
      "start": 35950,
      "end": 36007
    },
    {
      "file": "A41_c.html",
      "anchor": "a41-s-2",
      "text": "lorsque le cœur répond à une augmentation de remplissage",
      "id": "a41-j-starling",
      "start": 40037,
      "end": 40093
    },
    {
      "file": "A41_d.html",
      "anchor": "a41-p-3",
      "text": "Le rythme, la fréquence, l’ischémie des extrémités et le point de perfusion sont surveillés.",
      "id": "a41-j-rythme",
      "start": 15534,
      "end": 15626
    },
    {
      "file": "A41_d.html",
      "anchor": "a41-p-3",
      "text": "l’accumulation peut favoriser une neurotoxicité",
      "id": "a41-j-renal-antibiotique",
      "start": 17315,
      "end": 17362
    },
    {
      "file": "A41_b.html",
      "anchor": "a41-9",
      "text": "Le chlorure de sodium à 0,9 % expose à l’acidose hyperchlorémique et à une baisse de perfusion rénale.",
      "id": "a41-j-solutes",
      "start": 35278,
      "end": 35380
    },
    {
      "file": "A41_b.html",
      "anchor": "a41-9",
      "text": "Dans SOAP II (2010 ; 1 679 patients en choc), les arythmies étaient plus fréquentes sous dopamine : 24,1 % contre 12,4 %.",
      "id": "a41-j-vasopresseur-arythmies",
      "start": 39373,
      "end": 39494
    },
    {
      "file": "A41_b.html",
      "anchor": "a41-9",
      "text": "Les essais ProCESS (2014), ARISE (2014) et ProMISe (2015) n’ont pas montré de gain de survie avec l’ancienne réanimation protocolisée.",
      "id": "a41-j-perfusion-dynamique",
      "start": 37641,
      "end": 37775
    },
    {
      "file": "A41_a.html",
      "anchor": "a41-3",
      "text": "La constriction veineuse mobilise du sang vers le cœur et peut augmenter la précharge.",
      "id": "a41-j-retour-veineux",
      "start": 41187,
      "end": 41273
    }
  ],
  "exhaustive_review": false
}
