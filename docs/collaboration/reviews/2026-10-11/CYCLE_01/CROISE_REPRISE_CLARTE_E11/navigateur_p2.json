        {
          "location": "pA",
          "viewBoxWidth": 360,
          "renderedWidth": 717.0625,
          "labels": [
            {
              "text": "État normal : équilibre glucose",
              "font": 16,
              "effective": 31.869444444444444
            },
            {
              "text": "sécrétion et sensibilité à l’insuline",
              "font": 15,
              "effective": 29.877604166666668
            },
            {
              "text": "Excès adipeux et sédentarité",
              "font": 16,
              "effective": 31.869444444444444
            },
            {
              "text": "Résistance du muscle et du foie",
              "font": 15,
              "effective": 29.877604166666668
            },
            {
              "text": "Compensation : plus d’insuline",
              "font": 16,
              "effective": 31.869444444444444
            },
            {
              "text": "Puis défaillance des cellules β",
              "font": 15,
              "effective": 29.877604166666668
            },
            {
              "text": "Glucose sanguin trop élevé",
              "font": 16,
              "effective": 31.869444444444444
            },
            {
              "text": "à jeun et après le repas",
              "font": 15,
              "effective": 29.877604166666668
            },
            {
              "text": "Complications vasculaires",
              "font": 16,
              "effective": 31.869444444444444
            },
            {
              "text": "La glucotoxicité aggrave les cellules β",
              "font": 15,
              "effective": 29.877604166666668
            }
          ]
        },
        {
          "location": "pE",
          "viewBoxWidth": 360,
          "renderedWidth": 717.046875,
          "labels": [
            {
              "text": "Temps 0",
              "font": 16,
              "effective": 31.86875
            },
            {
              "text": "120 minutes",
              "font": 16,
              "effective": 31.86875
            },
            {
              "text": "Le patient prend 75 g de glucose oral.",
              "font": 16,
              "effective": 31.86875
            },
            {
              "text": "À jeun : ≥ 7,0 mmol/L",
              "font": 16,
              "effective": 31.86875
            },
            {
              "text": "À 2 heures : ≥ 11,1 mmol/L",
              "font": 16,
              "effective": 31.86875
            },
            {
              "text": "Ces seuils définissent le diabète.",
              "font": 16,
              "effective": 31.86875
            }
          ]
        },
        {
          "location": "e11-s-histo",
          "viewBoxWidth": 360,
          "renderedWidth": 717.0625,
          "labels": [
