              "pixelHeight": 19
            },
            {
              "text": "→ perte de cellules musculaires",
              "fontSize": 18,
              "pixelHeight": 19
            },
            {
              "text": "artérielles",
              "fontSize": 18,
              "pixelHeight": 19
            },
            {
              "text": "Pas une simple absence de signal",
              "fontSize": 18,
              "pixelHeight": 19
            },
