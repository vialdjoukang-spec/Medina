            }
          ]
        },
        {
          "label": "Fonctions normales et perturbations génétiques des cellules de paroi et de l’endothélium",
          "width": 380,
          "viewBox": "0 0 380 550",
          "texts": [
            {
              "text": "Notch 3 normal : signal → noyau →",
              "fontSize": 18,
              "pixelHeight": 19
            },
            {
              "text": "paroi",
              "fontSize": 18,
              "pixelHeight": 19
