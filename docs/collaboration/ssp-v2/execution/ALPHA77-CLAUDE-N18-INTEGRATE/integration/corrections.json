 "renvois_medicaux_lang": [
  {
   "id": "N18-LANG-R01",
   "question": "Latéralité « le droit souvent un peu plus que le gauche ».",
   "decision": "Conforme à la source : Hansen 2016 écrit « the right kidney is often slightly longer than the left kidney ». Texte inchangé.",
   "ancre": "N18-C0925",
   "sources": [
    "Hansen2016"
   ],
   "statut": "maintenu_verifie"
  },
  {
   "id": "N18-LANG-R02",
   "question": "Zone 50–60 % d’albumine non couverte.",
   "decision": "Les deux seuils (> 60 % glomérulaire, < 50 % tubulaire ou de surcharge) sont ceux du document HUG 2017, qui ne classe pas la zone intermédiaire ; phrase ajoutée : « Le document ne classe pas la zone comprise entre 50 et 60 %. »",
   "ancre": "N18-C1039",
   "sources": [
    "HUG2017"
   ],
   "statut": "corrige"
  },
  {
   "id": "N18-LANG-R03",
   "question": "« le jour même » et « le délai compte en jours ».",
   "decision": "Les quatre premières lignes du tableau reprennent les urgences néphrologiques HUG (« informer en urgence le néphrologue de garde ») ; justification réécrite en ce sens.",
   "ancre": "N18-C0957",
   "sources": [
    "HUG2017"
   ],
   "statut": "corrige"
  },
  {
   "id": "N18-LANG-R04",
   "question": "« accumulation change » : de quoi, dans quel sens ?",
   "decision": "Réécrit : « accumulation des médicaments éliminés par le rein augmente » (mécanisme énoncé par la FI Glucophage : insuffisance rénale → accumulation de metformine).",
   "ancre": "N18-C0304",
   "sources": [
    "FI_Glucophage",
    "FI_Forxiga"
   ],
   "statut": "corrige"
  },
  {
   "id": "N18-LANG-R05",
   "question": "Cellule Aranesp « jusqu’à stabilité, pression et fer ».",
   "decision": "Réécrit d’après la FI Aranesp : hémoglobine chaque semaine ou toutes les deux semaines jusqu’à stabilisation ; pression artérielle, surtout au début ; statut martial avant et pendant le traitement.",
   "ancre": "N18-C0301",
   "sources": [
    "FI_Aranesp"
   ],
   "statut": "corrige"
  },
  {
   "id": "N18-LANG-R06",
   "question": "« Traiter et orienter » et « Traiter et référer ».",
   "decision": "Libellés littéraux de la grille SSED/SSN (G1–G2 A3 = « Traiter et orienter », autres cases = « Traiter et référer »), sans définition de la différence dans la source ; libellés conservés et phrase explicative ajoutée en N18-C1048. KDIGO 2024 figure 13 ne porte pas ces mentions.",
   "ancre": "N18-C1048",
   "sources": [
    "SSED2024",
    "KDIGO2024"
   ],
   "statut": "corrige"
  }
 ],
